# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Email delivery service API key (Server-only secret).
# When provided, inquiries submitted via /api/contact are automatically emailed.
# If not provided, inquiries are recorded and logged safely in server memory and container logs.
RESEND_API_KEY=

# CONTACT_TO_EMAIL: The inbox where collaboration inquiries will be delivered.
# Note: When using the free onboarding@resend.dev sandbox, Resend only permits sending to
# your registered Resend account email (praju9307183730@gmail.com).
# Once you verify your custom domain in Resend, you can route to officialpratiksha26@gmail.com or any inbox.
CONTACT_TO_EMAIL="praju9307183730@gmail.com"

# CONTACT_FROM_EMAIL: The verified sender email registered in your Resend account.
# Defaults to "Portfolio Inquiries <onboarding@resend.dev>" for testing.
CONTACT_FROM_EMAIL="Portfolio Inquiries <onboarding@resend.dev>"

